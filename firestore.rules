rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Orders: publicly readable (needed for order tracking page + admin panel)
    // Anyone can CREATE an order (guest checkout supported)
    // Only Firebase console / admin can UPDATE or DELETE
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Customers: readable by anyone (needed by admin panel which has no Firebase Auth)
    // Only the authenticated owner can write their own profile
    match /customers/{customerId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == resource.data.uid;
    }
  }
}
