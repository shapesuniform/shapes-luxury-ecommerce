rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Orders: publicly readable (needed for order tracking page + admin panel)
    // Anyone can CREATE an order (guest checkout supported)
    // Only Firebase console / admin can UPDATE or DELETE
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Customers: readable by anyone (needed by admin panel which has no Firebase Auth)
    // Authenticated users can register and update their profile / login stats
    match /customers/{customerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Client Reviews: publicly readable and writable for seamless submission
    match /reviews/{reviewId} {
      allow read, create: if true;
      allow update, delete: if true;
    }
  }
}

