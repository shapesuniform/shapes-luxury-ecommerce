rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Products collection: publicly readable, writable for admin updates
    match /products/{productId} {
      allow read, write: if true;
    }

    // Store Settings & Categories
    match /store_settings/{settingId} {
      allow read, write: if true;
    }

    // Orders: readable & creatable for customers and admin
    match /orders/{orderId} {
      allow read, create, update, delete: if true;
    }

    // Customers: readable and writable
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Client Reviews: publicly readable and writable
    match /reviews/{reviewId} {
      allow read, create, update, delete: if true;
    }

    // Luxury Journal Articles
    match /journal/{articleId} {
      allow read, write: if true;
    }
  }
}

