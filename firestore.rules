rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Orders: readable by owner (uid) or anyone who knows the ref (for tracking page)
    // Writable by authenticated or unauthenticated (guest checkout)
    match /orders/{orderId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if true; // Allow guest + authenticated orders
      allow update, delete: if false; // Only admin can update via Firebase console
    }

    // Customers: readable and writable by the owner only
    match /customers/{customerId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
    }
  }
}
