# =============================================================================
# Netlify _headers — Cache + Security for shapesbysatinderkaur.com
# =============================================================================

# ---------------------------------------------------------------------------
# GLOBAL SECURITY HEADERS (applied to every request)
# ---------------------------------------------------------------------------
/*
  # Clickjacking protection (XFO + CSP frame-ancestors)
  X-Frame-Options: SAMEORIGIN

  # MIME-type sniffing protection
  X-Content-Type-Options: nosniff

  # Referrer info only sent to same origin on cross-origin requests
  Referrer-Policy: strict-origin-when-cross-origin

  # Disable sensitive browser features
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=()

  # HSTS — enforce HTTPS for 1 year (+ subdomains)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Cross-Origin Opener Policy — isolates top-level window from pop-ups
  Cross-Origin-Opener-Policy: same-origin-allow-popups

  # Cross-Origin Resource Policy
  Cross-Origin-Resource-Policy: cross-origin

  # Content Security Policy
  # - 'unsafe-inline' required because site uses inline <script> and style="" attrs
  # - All Firebase, Google, Razorpay, FontAwesome domains explicitly whitelisted
  # - frame-ancestors 'self' replaces X-Frame-Options for modern browsers
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://apis.google.com https://www.googletagmanager.com https://checkout.razorpay.com https://cdnjs.cloudflare.com https://shapes-boutique-e269d.firebaseapp.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://shapes-boutique-e269d.firebaseapp.com wss://firestore.googleapis.com https://api.razorpay.com https://lumberjack.razorpay.com; frame-src 'self' https://shapes-boutique-e269d.firebaseapp.com https://api.razorpay.com https://checkout.razorpay.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://checkout.razorpay.com; upgrade-insecure-requests;

# ---------------------------------------------------------------------------
# HTML — always revalidate (never serve stale HTML)
# ---------------------------------------------------------------------------
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# ---------------------------------------------------------------------------
# Service Worker — never cache
# ---------------------------------------------------------------------------
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

# ---------------------------------------------------------------------------
# Versioned JS/CSS — 1 year immutable cache
# (Version query string ?v=x.x busts cache on every deploy)
# ---------------------------------------------------------------------------
/index.js
  Cache-Control: public, max-age=31536000, immutable
/index.css
  Cache-Control: public, max-age=31536000, immutable
/admin.js
  Cache-Control: public, max-age=31536000, immutable
/admin.css
  Cache-Control: public, max-age=31536000, immutable

# Firebase config changes occasionally — 24h cache
/firebase-config.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

# ---------------------------------------------------------------------------
# Manifests — 24h cache
# ---------------------------------------------------------------------------
/manifest.json
  Cache-Control: public, max-age=86400, must-revalidate
/admin-manifest.json
  Cache-Control: public, max-age=86400, must-revalidate
/robots.txt
  Cache-Control: public, max-age=86400, must-revalidate
/sitemap.xml
  Cache-Control: public, max-age=86400, must-revalidate

# ---------------------------------------------------------------------------
# Static images — 1 year immutable cache
# ---------------------------------------------------------------------------
/images/*
  Cache-Control: public, max-age=31536000, immutable

# ---------------------------------------------------------------------------
# Web fonts — 1 year immutable cache
# ---------------------------------------------------------------------------
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  Cache-Control: public, max-age=31536000, immutable
