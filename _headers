# ═════════════════════════════════════════════════════════════════════════════
# CLOUDFLARE PAGES HEADERS CONFIGURATION — Shapes By Satiinder Kaur
# Edge Caching, Security Headers & Global Asset Performance
# ═════════════════════════════════════════════════════════════════════════════

# Global Security & Content Headers
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Access-Control-Allow-Origin: *

# Next-Gen Image Caching on 300+ Global Edge Data Centers (1 Year Cache)
/images/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*.webp
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*.png
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*.svg
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Stylesheets & Scripts with Versioning
/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Access-Control-Allow-Origin: *

/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Access-Control-Allow-Origin: *

# Web Manifest & Service Worker
/manifest.json
  Cache-Control: public, max-age=86400

/admin-manifest.json
  Cache-Control: public, max-age=86400

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# HTML Documents (Always Fresh for Dynamic Catalog Sync)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/.well-known/*
  Content-Type: text/plain
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400
